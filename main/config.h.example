/*
 * Firmware configuration — EXAMPLE / TEMPLATE (safe to commit).
 *
 * Copy this file to `config.h` and edit it to match your hardware / network:
 *
 *     cp config.h.example config.h
 *
 * `config.h` is git-ignored (it holds your WiFi credentials) — commit only
 * this `.example` file.
 *
 * The values below are safe defaults / placeholders. In practice you usually
 * only need to change the WiFi SSID/password, the firmware URL, and (if your
 * board differs) the GPIO pins and shunt calibration.
 */

#pragma once

#include "driver/gpio.h"

// ---------------------------------------------------------------------------
// Network
// ---------------------------------------------------------------------------
#define CFG_WIFI_SSID    "CHANGE_ME_SSID"
#define CFG_WIFI_PASS    "CHANGE_ME_PASSWORD"
// DHCP hostname, 1-32 letters/digits/hyphens, without a domain suffix.
#define CFG_HOSTNAME     "power-monitor"
#define CFG_NTP_HOST     "ntp.aliyun.com"  // SNTP server (UTC)

// ---------------------------------------------------------------------------
// GPIO — shared I2C bus (INA226 + SSD1306). Internal pull-ups enabled in code.
// ---------------------------------------------------------------------------
#define CFG_I2C_SDA      GPIO_NUM_4
#define CFG_I2C_SCL      GPIO_NUM_5

// Status LED: active HIGH; on when WiFi is connected, off otherwise.
#define CFG_LED_PIN      GPIO_NUM_8

// INA226 ALERT pin (open-drain, active low). Monitored as a polled input.
#define CFG_ALERT_PIN    GPIO_NUM_3

// USB-JTAG: GPIO18 (D-) / GPIO19 (D+) are the built-in USB-Serial-JTAG.
// Do NOT repurpose these pins.
#define CFG_USB_JTAG_DMINUS  GPIO_NUM_18
#define CFG_USB_JTAG_DPLUS   GPIO_NUM_19

// ---------------------------------------------------------------------------
// INA226 calibration: shunt resistance + expected MAXIMUM current.
// The chip requires max_current * shunt <= 81.9 mV. 10 A needs shunt <= ~8.2 mOhm.
// ---------------------------------------------------------------------------
#define CFG_MAX_CURRENT_A  10.0f
#define CFG_SHUNT_OHM      0.005f          // 5 mOhm  ->  50 mV at 10 A  (OK)

// Overcurrent alert threshold (amperes). The INA226 ALERT pin asserts when the
// sampled current exceeds this (shunt comparator); firmware logs the alert locally. Independent of CFG_MAX_CURRENT_A (which only sets full-scale).
#define CFG_OCP_THRESHOLD_A 2.5f

// ---------------------------------------------------------------------------
// Behaviour
// ---------------------------------------------------------------------------
#define NORMAL_INTERVAL_MS  100u     // 10 Hz
#define SLOW_INTERVAL_MS    1000u    // 1 Hz
#define DEFAULT_INTERVAL_MS NORMAL_INTERVAL_MS
#define OLED_REFRESH_MS     100u     // hard cap: never faster

// ---------------------------------------------------------------------------
// OTA (over-the-air update)
// ---------------------------------------------------------------------------
// POST /api/ota/update starts downloading this fixed firmware URL.
#define CFG_OTA_URL "http://192.168.1.100:38000/ota/firmware.bin"
