# Durable build config for the two-slot OTA layout.
#
# Merged into `sdkconfig` at configure time (the live sdkconfig is git-ignored,
# so this is the committed source of truth for these choices). See
# partitions.csv for the table itself.
#
# - Use the custom two-OTA partition table (no factory slot) at the repo root.
# - Enable app rollback so a new image that fails to confirm itself auto-reverts
#   to the previous app (the app calls esp_ota_mark_app_valid_cancel_rollback()
#   on a healthy boot; the bootloader reverts if the new app dies before that).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# - Keep a 1 kHz tick for precise short delays (sensor conversions / debounce).
#   Sampling now sleeps until its deadline rather than polling every 5 ms.
#   Tasks assert that configured delays cannot round down to zero ticks.
CONFIG_FREERTOS_HZ=1000

# UART0 is reserved for HLK-LD2410C-P; console uses native USB (GPIO18/19).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
